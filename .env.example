# Vikunja MCP Server Configuration
# Copy this to .env and fill in your values

# Your Vikunja instance URL (no trailing slash)
VIKUNJA_URL=https://vikunja.lindenlion.net

# API token used to authenticate every request to your Vikunja instance.
# Create one in Vikunja under Settings > API Tokens.
# Grant it read/write access to tasks, projects, and labels.
# Example: a0b1c2d3e4f5...  (long hex string from Vikunja)
VIKUNJA_TOKEN=your-api-token-here

# Optional: shared secret that protects the /mcp endpoint from unauthorized use.
# When set, callers must append ?token=<value> to the connector URL.
# Generate a strong random value, e.g.:
#   openssl rand -hex 32
# Leave unset (or empty) to disable auth — only do this on a private network.
MCP_AUTH_TOKEN=

# Port the MCP server listens on
# On Uberspace, pick an unused port (e.g. 9090)
PORT=9090
