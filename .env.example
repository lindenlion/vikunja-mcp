# Vikunja MCP Server Configuration
# Copy this to .env and fill in your values

# Your Vikunja instance URL (no trailing slash)
VIKUNJA_URL=https://vikunja.lindenlion.net

# API token from Vikunja Settings > API Tokens
# Create one with read/write access to tasks, projects, labels
VIKUNJA_TOKEN=your-api-token-here

# Port the MCP server listens on
# On Uberspace, pick an unused port (e.g. 9090)
PORT=9090
